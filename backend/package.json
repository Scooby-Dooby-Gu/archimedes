{
  "name": "@archimedesfinance/backend",
  "version": "1.0.0",
  "description": "Backend for archimedes",
  "main": "app/index.js",
  "scripts": {
    "start": "./node_modules/.bin/per-env",
    "start:qa": "NODE_ENV=qa  node_modules/.bin/pm2 start --no-daemon  --wait-ready --listen-timeout 3000 --env=qa --node-args=\"-r dotenv-safe/config --expose-gc \" app/index.js -i 2 -f --name=\"Archimedes\"",
    "start:production": "NODE_ENV=production  node_modules/.bin/pm2 start --no-daemon  --wait-ready --listen-timeout 3000 --env=production --node-args=\"-r dotenv-safe/config --expose-gc\" app/index.js -i 4 -f --name=\"Archimedes\"",
    "start:staging": "NODE_ENV=staging  node_modules/.bin/pm2 start --no-daemon  --wait-ready --listen-timeout 3000 --env=staging --node-args=\"-r dotenv-safe/config --expose-gc\" app/index.js -i 4 -f --name=\"Archimedes\"",
    "start:development": "nodemon --expose-gc -r dotenv-safe/config app/index.js dotenv_config_allowEmptyValues=true",
    "start:once": "node --expose-gc -r dotenv-safe/config app/index.js dotenv_config_allowEmptyValues=true",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:setup": "node scripts/db.js setup",
    "db:migrate": "node scripts/db.js migrate",
    "vercel-build": "node scripts/db.js vercel-build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchimedesFinance/backend.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ArchimedesFinance/backend/issues"
  },
  "homepage": "https://github.com/ArchimedesFinance/backend#readme",
  "dependencies": {
    "@sentry/integrations": "^5.10.2",
    "@sentry/node": "^5.10.2",
    "apn": "^2.2.0",
    "aws-sdk": "^2.580.0",
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^8.6.0",
    "dotenv-safe": "^8.2.0",
    "esm": "^3.2.25",
    "express": "^4.17.1",
    "glob": "^7.1.6",
    "google-auth-library": "^5.7.0",
    "html-entities": "^2.3.2",
    "inflection": "^1.12.0",
    "jose": "^6.2.15",
    "multer": "^1.4.2",
    "multer-s3": "^2.9.0",
    "node-run-middleware": "^0.7.1",
    "nodemon": "^2.0.1",
    "open-graph-scraper": "^4.9.1",
    "per-env": "^1.0.2",
    "pg": "^8.0.3",
    "pm2": "^4.5.5",
    "request": "^2.88.0",
    "run-middleware": "^0.9.10",
    "sharp": "^0.34.0",
    "web-push": "^3.4.4"
  },
  "type": "module"
}
