APP_URL=
PORT=

AWS_S3_USER_UPLOADS_BUCKET='archimedes-user-uploads-development'
AWS_S3_USER_UPLOADS_BUCKET_REGION='us-east-2'
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SENDGRID_API_KEY=

SENTRY_DSN=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

PM2_PUBLIC_KEY=
PM2_SECRET_KEY=

# Google sign-in (Google Identity Services, authorization-code popup flow).
# Create a "Web application" OAuth client in Google Cloud Console and add the
# frontend origin (e.g. http://localhost:8080) under Authorized JavaScript origins.
# The frontend needs the same GOOGLE_CLIENT_ID in frontend/.env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Sign in with Apple. Your Services ID (e.g. com.example.archimedes.web).
# Leave empty to keep Apple sign-in disabled. The frontend needs the same value.
# APPLE_CLIENT_ID=
# Optional: Slack incoming webhook for internal notifications
# SLACK_WEBHOOK_URL=

# --- Hosting (see DEPLOY.md) ---
# Postgres connection. On Vercel + Neon use the pooled URL here; the Neon
# integration also sets DATABASE_URL_UNPOOLED, which `npm run db:*` prefers.
# Locally you can use PGDATABASE=archimedes instead.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# PG_POOL_MAX=3
# Optional: Apple push. APN_KEY is the .p8 file contents ("\n" for newlines).
# APN_KEY=
# APN_KEY_ID=
# APN_TEAM_ID=
# Optional: contact for web push (VAPID), e.g. mailto:you@example.com
# VAPID_SUBJECT=
# Optional: log SQL with parameter values (never enable in production).
# LOG_SQL=true
