NODE_ENV=development
API_URL=http://localhost:3001
APP_URL=http://localhost:8080

# Optional. Same OAuth client ID as the backend's GOOGLE_CLIENT_ID.
# Leave empty to keep "Sign in with Google" disabled.
GOOGLE_CLIENT_ID=

# Optional. Same Services ID as the backend's APPLE_CLIENT_ID.
# Leave empty to keep "Sign in with Apple" disabled.
APPLE_CLIENT_ID=

# Optional. Public marketing site (defaults to APP_URL) and contact address.
SITE_URL=
CONTACT_EMAIL=
