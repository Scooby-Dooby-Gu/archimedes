{
	"name": "ArchimedesFrontend",
	"scripts": {
		"start": "./node_modules/.bin/per-env",
		"start:production": "npm run build; npm run -s serve",
		"start:staging": "npm run build; npm run -s serve",
		"start:development": "./node_modules/.bin/vite",
		"build:app": "./node_modules/.bin/vite --base ${APP_URL:-./} --config vite.config.mjs build && sed -i -E \"s^window.NODE_ENV^\\\"$NODE_ENV\\\"^;s^window.SENTRY_DSN^\\\"$SENTRY_DSN\\\"^;s^type=\\\"module\\\"^type=\\\"module\\\" onerror=\\\"reloadApp()\\\"^\" dist/index.html;",
		"build:marketing": "./node_modules/.bin/vite --base ${APP_URL:-./}   --config vite.marketing.config.mjs build && sed -i -E \"s^window.NODE_ENV^\\\"$NODE_ENV\\\"^;s^window.SENTRY_DSN^\\\"$SENTRY_DSN\\\"^\" dist/marketing.html;",
		"build": "npm run build:app && npm run build:marketing",
		"serve": "./node_modules/.bin/vite serve"
	},
	"eslintConfig": {
		"extends": "preact",
		"globals": {
			"dispatch": "readonly",
			"route": "readonly"
		}
	},
	"dependencies": {
		"@preact/preset-vite": "^2.1.5",
		"@react-spring/web": "^9.1.2",
		"@sentry/browser": "^6.4.1",
		"@use-gesture/react": "^10.1.3",
		"@wmrjs/service-worker": "^0.3.0",
		"deep-equal": "^2.0.3",
		"dotenv": "^8.6.0",
		"fast-deep-equal": "^3.1.1",
		"htm": "^3.0.4",
		"immutability-helper": "^3.0.1",
		"inflection": "^1.12.0",
		"pikaday": "^1.8.0",
		"preact": "^10.5.13",
		"preact-iso": "^2.0.2",
		"preact-render-to-string": "^5.1.0",
		"qs": "^6.9.0",
		"react-attr-converter": "^0.3.1",
		"react-spring": "^9.3.0",
		"sass": "^1.43.4",
		"seamless-scroll-polyfill": "^1.0.10",
		"sentry": "^0.1.2",
		"slimdown-js": "^0.2.1",
		"stats.js": "^0.17.0",
		"three-fbx-loader": "^1.0.3",
		"url-search-params": "^1.1.0",
		"vite": "^2.6.14",
		"workbox-core": "^5.1.4",
		"workbox-recipes": "^6.1.5"
	},
	"devDependencies": {
		"appcache-webpack-plugin": "^1.4.0",
		"autoprefixer": "^9.7.4",
		"dotenv-safe": "^8.2.0",
		"eslint": "^6.0.1",
		"eslint-config-synacor": "^3.0.4",
		"gltf-pipeline": "^3.0.0",
		"identity-obj-proxy": "^3.0.0",
		"per-env": "^1.0.2",
		"postcss-pixels-to-rem": "^0.8.0",
		"serve": "^11.3.2",
		"svgstore": "^3.0.0-2",
		"workbox-cacheable-response": "^5.0.0"
	}
}
